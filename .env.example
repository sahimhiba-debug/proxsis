# Copier en .env (jamais versionné). Aucune valeur réelle ici.

# --- IA (optionnel). Une seule règle (proxsis.llm.base.chosen_provider) : Apertus seulement si
# PROXSIS_LLM_PROVIDER=apertus ET une clé (variable ou trousseau macOS) ; sinon le faux fournisseur, déterministe.
# Une clé seule ne suffit pas : l'export de la démo reste reproductible tant que le choix n'est pas fait.
PROXSIS_LLM_PROVIDER=fake            # fake | apertus
PUBLICAI_BASE_URL=https://api.publicai.co/v1   # vérifié le 2026-10-05 ; en-tête User-Agent obligatoire
PUBLICAI_API_KEY=                              # ou trousseau macOS, service proxsis-publicai (voir proxsis/llm/secrets.py)
APERTUS_MODEL=swiss-ai/apertus-v1.5-8b         # id documenté (platform.publicai.co/docs, lu le 2026-10-05)

# --- Données
PROXSIS_OFFLINE=1                    # 1 = « proxsis update » rejoue le cache seulement, aucun appel réseau
PROXSIS_USER_AGENT=Proxsis/0.1 (+contact: a-definir@exemple.ch)
ZEFIX_API_USER=                        # Zefix PublicREST : compte gratuit à demander (non utilisé sans accord de Hiba)
ZEFIX_API_PASSWORD=

# --- Web (sans Supabase, les retours d'appel restent sur l'appareil). Seules la clé publique (anon) et l'adresse vont
# dans l'application ; la clé service_role ne doit jamais y figurer (docs/deploiement_vercel_supabase.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
