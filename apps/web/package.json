{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "visuel": "playwright test -c playwright.visuel.config.ts",
    "visuel:temps": "for d in 0 2 30 90; do echo \"J+$d\"; VISUEL_DECALAGE_JOURS=$d playwright test -c playwright.visuel.config.ts || exit 1; done",
    "build:static": "STATIC_EXPORT=1 next build",
    "moteurs": "playwright test -c playwright.moteurs.config.ts",
    "serve:static": "python3 -m http.server 4310 -d out",
    "e2e:prepare": "STATIC_EXPORT=1 next build && next build",
    "knip": "knip",
    "cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "gsap": "3.15.0",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "knip": "5.66.1",
    "madge": "8.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
